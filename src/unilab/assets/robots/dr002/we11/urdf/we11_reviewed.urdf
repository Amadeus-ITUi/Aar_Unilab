      <geometry>
        <box size="0.11 0.08 0.11" />
      </geometry>
    </collision>
  </link>

  <!-- ================================================================ -->
  <!-- 左腿: thigh -> calf -> foot (全抄 reviewed, 只改 visual mesh 路径) -->
  <!-- ================================================================ -->
  <link name="left_thigh_link">
