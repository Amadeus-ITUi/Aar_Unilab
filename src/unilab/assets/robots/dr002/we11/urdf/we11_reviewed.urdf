<?xml version="1.0" encoding="utf-8"?>
<robot name="we11_my_version">

  <!-- ================================================================ -->
  <!-- base_link: inertial 抄新版 (含云台/电子/尾翼固定部分)                 -->
  <!--            collision 抄旧版 reviewed 简化 box                     -->
  <!--            visual 用新版 mesh                                     -->
  <!-- ================================================================ -->
  <link name="base_link">
    <inertial>
      <origin xyz="0.04588263 3.771e-05 0.04501853" rpy="0 0 0" />
      <mass value="1.79744014" />
      <inertia ixx="0.01509778" ixy="1.56e-06" ixz="-0.01047094"
               iyy="0.02513929" iyz="-5.9e-07" izz="0.01378862" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="../meshes_lod/base_link.STL" />
      </geometry>
      <material name="">
        <color rgba="0.75294 0.75294 0.75294 1" />
      </material>
    </visual>
    <collision name="base_link_collision">
      <origin xyz="-0.019765 0 -0.0045" rpy="0 0 0" />
      <geometry>
        <box size="0.12797 0.1183 0.11" />
      </geometry>
