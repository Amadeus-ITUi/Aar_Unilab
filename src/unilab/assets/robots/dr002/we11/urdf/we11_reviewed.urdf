  <!-- ================================================================ -->
  <!-- 左翼: revolute, 零位=17.5° 上抬 (limit -17.5°~+72.5°, 共 90°)      -->
  <!-- inertial 抄新版 CAD; visual 用新版 mesh; collision 用简化 box       -->
  <!-- effort/velocity/dynamics 复用大腿关节实机辨识值                     -->
  <!-- ================================================================ -->
  <link name="left_wing_link">
    <inertial>
      <origin xyz="-0.04294591 0.29416066 -0.11926569" rpy="0 0 0" />
      <mass value="0.06633" />
      <inertia ixx="0.00448339" ixy="0.00104762" ixz="0.00028627"
