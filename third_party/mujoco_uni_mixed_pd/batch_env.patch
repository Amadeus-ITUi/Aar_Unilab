+void _unsafe_step_mixed_pd_threaded(
+    const std::vector<const raw::MjModel*>& m,
+    std::vector<raw::MjData*>& d, int nbatch, int nstep,
+    unsigned int control_spec, const mjtNum* state0, const mjtNum* control,
+    const mjtNum* kp, const mjtNum* kd, const mjtNum* torque_scale,
+    const mjtNum* initial_joint_pos, const mjtNum* initial_joint_vel,
+    const int* position_mask, const int* pos_sensor_adr,
+    const int* vel_sensor_adr, const mjtNum* ctrl_lower,
+    const mjtNum* ctrl_upper, bool quantize_float32, mjtNum* state_out,
+    mjtNum* sensordata_out, mjtNum* motor_ctrl_out, ThreadPool* pool,
+    int chunk_size) {
+  int nfulljobs = nbatch / chunk_size;
+  int chunk_remainder = nbatch % chunk_size;
+  int njobs = chunk_remainder > 0 ? nfulljobs + 1 : nfulljobs;
+  pool->ResetCount();
+
+  for (int j = 0; j < nfulljobs; ++j) {
+    auto task = [=, &m, &d](void) {
+      int id = pool->WorkerId();
+      _unsafe_step_mixed_pd(
+          m, d[id], j * chunk_size, (j + 1) * chunk_size, nstep,
+          control_spec, state0, control, kp, kd, torque_scale,
+          initial_joint_pos, initial_joint_vel, position_mask, pos_sensor_adr,
+          vel_sensor_adr, ctrl_lower, ctrl_upper, quantize_float32, state_out,
+          sensordata_out, motor_ctrl_out);
+    };
+    pool->Schedule(task);
+  }
+  if (chunk_remainder > 0) {
+    auto task = [=, &m, &d](void) {
+      _unsafe_step_mixed_pd(
+          m, d[pool->WorkerId()], nfulljobs * chunk_size,
+          nfulljobs * chunk_size + chunk_remainder, nstep, control_spec,
+          state0, control, kp, kd, torque_scale, initial_joint_pos,
+          initial_joint_vel, position_mask, pos_sensor_adr, vel_sensor_adr,
+          ctrl_lower, ctrl_upper, quantize_float32, state_out, sensordata_out,
+          motor_ctrl_out);
+    };
+    pool->Schedule(task);
+  }
+  pool->WaitCount(njobs);
+}
