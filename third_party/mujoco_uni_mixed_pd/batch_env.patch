   // -----------------------------------------------------------------
+  // Multi-step mixed position/velocity PD stepping. CTRL entries in the
+  // control trajectory are policy targets; this method converts them to
+  // motor torques inside the native substep loop.
+  // -----------------------------------------------------------------
+  py::tuple step_mixed_pd(
+      int nstep, unsigned int control_spec, const PyCArray state0,
+      const PyCArray control, const PyCArray kp, const PyCArray kd,
+      const PyCArray torque_scale, const PyCArray initial_joint_pos,
