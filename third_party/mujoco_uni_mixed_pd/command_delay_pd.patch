   // -----------------------------------------------------------------
+  // Multi-step decimated PD with a persistent pre-controller command FIFO.
+  // The FIFO and PD advance only on motor ticks; actuator torque is held on
+  // intervening physics steps.
+  // -----------------------------------------------------------------
+  py::tuple step_command_delay_pd(
+      int nstep, unsigned int control_spec, const PyCArray state0,
+      const PyCArray control, const PyCArray kp, const PyCArray kd,
+      const PyCArray torque_scale, const PyCArray initial_joint_pos,
+      const PyCArray initial_joint_vel, const PyIArray position_mask,
+      const PyIArray pos_sensor_adr, const PyIArray vel_sensor_adr,
+      const PyCArray ctrl_lower, const PyCArray ctrl_upper,
+      int motor_control_decimation, int initial_motor_substep_index,
+      const PyIArray command_delay_steps,
+      const PyCArray initial_command_delay_buffer,
+      const PyCArray initial_motor_ctrl, bool quantize_float32,
+      std::optional<int> chunk_size) {
+    if (nstep < 1) {
+      throw py::value_error("nstep must be >= 1");
+    }
+    if (!(control_spec & mjSTATE_CTRL)) {
+      throw py::value_error("step_command_delay_pd requires mjSTATE_CTRL");
+    }
+    if (state0.shape(0) != nbatch_) {
+      std::ostringstream msg;
+      msg << "state0.shape[0]=" << state0.shape(0)
+          << " does not match pool nbatch=" << nbatch_;
+      throw py::value_error(msg.str());
+    }
+    if (motor_control_decimation < 1) {
+      throw py::value_error("motor_control_decimation must be positive");
+    }
+    if (initial_motor_substep_index < 0 ||
+        initial_motor_substep_index >= motor_control_decimation) {
+      throw py::value_error(
+          "initial_motor_substep_index must be inside the motor decimation");
+    }
+    if (chunk_size.has_value() && *chunk_size <= 0) {
+      throw py::value_error("chunk_size must be positive");
+    }
+
+    int nu = models_[0]->nu;
+    int ncontrol = mj_stateSize(models_[0], control_spec);
+    size_t batch_actuator_size = static_cast<size_t>(nbatch_) * nu;
+    size_t control_size =
+        static_cast<size_t>(nbatch_) * nstep * ncontrol;
+
+    std::optional<PyCArray> state0_opt = state0;
+    mjtNum* state0_ptr = optional_array_ptr(
+        state0_opt, "state0", static_cast<size_t>(nbatch_) * nstate_);
+    mjtNum* control_ptr = required_array_ptr(control, "control", control_size);
+    mjtNum* kp_ptr = required_array_ptr(kp, "kp", batch_actuator_size);
+    mjtNum* kd_ptr = required_array_ptr(kd, "kd", batch_actuator_size);
+    mjtNum* torque_scale_ptr = required_array_ptr(
+        torque_scale, "torque_scale", batch_actuator_size);
+    mjtNum* initial_joint_pos_ptr = required_array_ptr(
+        initial_joint_pos, "initial_joint_pos", batch_actuator_size);
+    mjtNum* initial_joint_vel_ptr = required_array_ptr(
+        initial_joint_vel, "initial_joint_vel", batch_actuator_size);
+    mjtNum* initial_motor_ctrl_ptr = required_array_ptr(
+        initial_motor_ctrl, "initial_motor_ctrl", batch_actuator_size);
+    mjtNum* ctrl_lower_ptr =
+        required_array_ptr(ctrl_lower, "ctrl_lower", nu);
+    mjtNum* ctrl_upper_ptr =
+        required_array_ptr(ctrl_upper, "ctrl_upper", nu);
+
+    py::buffer_info position_mask_info = position_mask.request();
+    py::buffer_info pos_sensor_info = pos_sensor_adr.request();
+    py::buffer_info vel_sensor_info = vel_sensor_adr.request();
+    py::buffer_info command_delay_steps_info = command_delay_steps.request();
+    py::buffer_info command_delay_buffer_info =
+        initial_command_delay_buffer.request();
+    if (position_mask_info.size != nu || pos_sensor_info.size != nu ||
+        vel_sensor_info.size != nu ||
+        command_delay_steps_info.size != batch_actuator_size) {
+      throw py::value_error(
+          "position_mask, pos_sensor_adr, and vel_sensor_adr must have size nu; "
+          "command_delay_steps must have size nbatch*nu");
+    }
+    if (command_delay_buffer_info.ndim != 3 ||
+        command_delay_buffer_info.shape[0] != nbatch_ ||
+        command_delay_buffer_info.shape[2] != nu) {
+      throw py::value_error(
+          "initial_command_delay_buffer must have shape (nbatch, depth, nu)");
+    }
+    int command_delay_depth =
+        static_cast<int>(command_delay_buffer_info.shape[1]);
+    if (command_delay_depth < 1) {
+      throw py::value_error("command-delay FIFO depth must be positive");
+    }
+    const int* position_mask_ptr =
+        static_cast<const int*>(position_mask_info.ptr);
+    const int* pos_sensor_ptr = static_cast<const int*>(pos_sensor_info.ptr);
+    const int* vel_sensor_ptr = static_cast<const int*>(vel_sensor_info.ptr);
+    const int* command_delay_steps_ptr =
+        static_cast<const int*>(command_delay_steps_info.ptr);
+    for (int i = 0; i < nu; ++i) {
+      if (position_mask_ptr[i] != 0 && position_mask_ptr[i] != 1) {
+        throw py::value_error("position_mask entries must be 0 or 1");
+      }
+      if (pos_sensor_ptr[i] < 0 || pos_sensor_ptr[i] >= nsensordata_ ||
+          vel_sensor_ptr[i] < 0 || vel_sensor_ptr[i] >= nsensordata_) {
+        throw py::value_error("joint sensor address is out of range");
+      }
+      if (ctrl_lower_ptr[i] > ctrl_upper_ptr[i]) {
+        throw py::value_error("ctrl_lower must not exceed ctrl_upper");
+      }
+    }
+    for (size_t i = 0; i < batch_actuator_size; ++i) {
+      if (command_delay_steps_ptr[i] < 0 ||
+          command_delay_steps_ptr[i] >= command_delay_depth) {
+        throw py::value_error(
+            "command_delay_steps entries must index the command FIFO depth");
+      }
+    }
+    size_t command_delay_buffer_size =
+        static_cast<size_t>(nbatch_) * command_delay_depth * nu;
+    mjtNum* initial_command_delay_buffer_ptr = required_array_ptr(
+        initial_command_delay_buffer, "initial_command_delay_buffer",
+        command_delay_buffer_size);
+
+    PyCArray state_out({nbatch_, nstate_});
+    PyCArray sensordata_out({nbatch_, nsensordata_});
+    PyCArray motor_ctrl_out({nbatch_, nu});
+    PyCArray computed_motor_ctrl_out({nbatch_, nu});
+    PyCArray command_delay_buffer_out(
+        {nbatch_, command_delay_depth, nu});
+    mjtNum* state_ptr = static_cast<mjtNum*>(state_out.request().ptr);
+    mjtNum* sensor_ptr =
+        static_cast<mjtNum*>(sensordata_out.request().ptr);
+    mjtNum* motor_ctrl_ptr =
+        static_cast<mjtNum*>(motor_ctrl_out.request().ptr);
+    mjtNum* computed_motor_ctrl_ptr =
+        static_cast<mjtNum*>(computed_motor_ctrl_out.request().ptr);
+    mjtNum* command_delay_buffer_ptr =
+        static_cast<mjtNum*>(command_delay_buffer_out.request().ptr);
+
+    std::vector<const raw::MjModel*> cmodels(nbatch_);
+    for (int i = 0; i < nbatch_; ++i) cmodels[i] = models_[i];
+
+    {
+      py::gil_scoped_release no_gil;
+      if (nthread_ > 0 && nbatch_ > 1) {
+        int chunk = chunk_size.has_value()
+                        ? *chunk_size
+                        : std::max(1, nbatch_ / (10 * nthread_));
+        InterceptMjErrors(_unsafe_step_command_delay_pd_threaded)(
+            cmodels, worker_data_, nbatch_, nstep, control_spec, state0_ptr,
+            control_ptr, kp_ptr, kd_ptr, torque_scale_ptr,
+            initial_joint_pos_ptr, initial_joint_vel_ptr, position_mask_ptr,
+            pos_sensor_ptr, vel_sensor_ptr, ctrl_lower_ptr, ctrl_upper_ptr,
+            motor_control_decimation, initial_motor_substep_index,
+            command_delay_steps_ptr, command_delay_depth,
+            initial_command_delay_buffer_ptr, initial_motor_ctrl_ptr,
+            quantize_float32, state_ptr, sensor_ptr, motor_ctrl_ptr,
+            computed_motor_ctrl_ptr, command_delay_buffer_ptr, pool_.get(),
+            chunk);
+      } else {
+        InterceptMjErrors(_unsafe_step_command_delay_pd)(
+            cmodels, worker_data_[0], 0, nbatch_, nstep, control_spec,
+            state0_ptr, control_ptr, kp_ptr, kd_ptr, torque_scale_ptr,
+            initial_joint_pos_ptr, initial_joint_vel_ptr, position_mask_ptr,
+            pos_sensor_ptr, vel_sensor_ptr, ctrl_lower_ptr, ctrl_upper_ptr,
+            motor_control_decimation, initial_motor_substep_index,
+            command_delay_steps_ptr, command_delay_depth,
+            initial_command_delay_buffer_ptr, initial_motor_ctrl_ptr,
+            quantize_float32, state_ptr, sensor_ptr, motor_ctrl_ptr,
+            computed_motor_ctrl_ptr, command_delay_buffer_ptr);
+      }
+    }
+    return py::make_tuple(
+        state_out, sensordata_out, motor_ctrl_out, computed_motor_ctrl_out,
+        command_delay_buffer_out);
+  }
