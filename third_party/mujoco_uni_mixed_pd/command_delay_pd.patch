+// DR002 pre-controller command FIFO with a decimated, zero-order-held motor
+// controller. Policy targets and external inputs still arrive as one sample
+// per physics substep, but the FIFO and PD advance only on motor ticks.
+void _unsafe_step_command_delay_pd(
+    const std::vector<const raw::MjModel*>& m, raw::MjData* d,
+    int start_roll, int end_roll, int nstep, unsigned int control_spec,
+    const mjtNum* state0, const mjtNum* control, const mjtNum* kp,
+    const mjtNum* kd, const mjtNum* torque_scale,
+    const mjtNum* initial_joint_pos, const mjtNum* initial_joint_vel,
+    const int* position_mask, const int* pos_sensor_adr,
+    const int* vel_sensor_adr, const mjtNum* ctrl_lower,
+    const mjtNum* ctrl_upper, int motor_control_decimation,
+    int initial_motor_substep_index, const int* command_delay_steps,
+    int command_delay_depth, const mjtNum* initial_command_delay_buffer,
+    const mjtNum* initial_motor_ctrl, bool quantize_float32,
+    mjtNum* state_out, mjtNum* sensordata_out, mjtNum* motor_ctrl_out,
+    mjtNum* computed_motor_ctrl_out, mjtNum* command_delay_buffer_out) {
+  size_t nstate = static_cast<size_t>(mj_stateSize(m[0], mjSTATE_FULLPHYSICS));
+  size_t ncontrol = static_cast<size_t>(mj_stateSize(m[0], control_spec));
+  size_t nv = static_cast<size_t>(m[0]->nv);
+  size_t nsensordata = static_cast<size_t>(m[0]->nsensordata);
+  int nu = m[0]->nu;
+  int nbody = m[0]->nbody;
+  int neq = m[0]->neq;
+
+  std::vector<mjtNum> feedback_pos(nu);
+  std::vector<mjtNum> feedback_vel(nu);
+  std::vector<mjtNum> held_motor_ctrl(nu);
+  std::vector<mjtNum> computed_motor_ctrl(nu);
+  std::vector<mjtNum> command_delay_buffer(
+      static_cast<size_t>(command_delay_depth) * nu);
+  std::vector<mjtNum> state_scratch(nstate);
+
+  if (!(control_spec & mjSTATE_QFRC_APPLIED)) {
+    mju_zero(d->qfrc_applied, nv);
+  }
+  if (!(control_spec & mjSTATE_XFRC_APPLIED)) {
+    mju_zero(d->xfrc_applied, 6 * nbody);
+  }
+
+  for (size_t r = start_roll; r < static_cast<size_t>(end_roll); ++r) {
+    for (int i = 0; i < nbody; ++i) {
+      int id = m[r]->body_mocapid[i];
+      if (id >= 0) {
+        mju_copy3(d->mocap_pos + 3 * id, m[r]->body_pos + 3 * i);
+        mju_copy4(d->mocap_quat + 4 * id, m[r]->body_quat + 4 * i);
+      }
+    }
+    for (int i = 0; i < neq; ++i) {
+      d->eq_active[i] = m[r]->eq_active0[i];
+    }
+
+    mj_setState(m[r], d, state0 + r * nstate, mjSTATE_FULLPHYSICS);
+    for (int i = 0; i < nu; ++i) {
+      feedback_pos[i] = initial_joint_pos[r * nu + i];
+      feedback_vel[i] = initial_joint_vel[r * nu + i];
+      held_motor_ctrl[i] = initial_motor_ctrl[r * nu + i];
+      computed_motor_ctrl[i] = initial_motor_ctrl[r * nu + i];
+    }
+    size_t command_delay_offset =
+        r * static_cast<size_t>(command_delay_depth) * nu;
+    mju_copy(command_delay_buffer.data(),
+             initial_command_delay_buffer + command_delay_offset,
+             static_cast<size_t>(command_delay_depth) * nu);
+
+    for (int t = 0; t < nstep; ++t) {
+      size_t step = r * static_cast<size_t>(nstep) + t;
+      mj_setState(m[r], d, control + step * ncontrol, control_spec);
+      bool motor_tick =
+          (initial_motor_substep_index + t) % motor_control_decimation == 0;
+
+      if (motor_tick) {
+        for (int i = 0; i < nu; ++i) {
+          for (int age = command_delay_depth - 1; age > 0; --age) {
+            command_delay_buffer[static_cast<size_t>(age) * nu + i] =
+                command_delay_buffer[static_cast<size_t>(age - 1) * nu + i];
+          }
+          mjtNum target = d->ctrl[i];
+          if (quantize_float32) {
+            target = static_cast<mjtNum>(static_cast<float>(target));
+          }
+          command_delay_buffer[i] = target;
+        }
+
+        for (int i = 0; i < nu; ++i) {
+          size_t delay_index =
+              static_cast<size_t>(command_delay_steps[r * nu + i]) * nu + i;
+          mjtNum delayed_target = command_delay_buffer[delay_index];
+          mjtNum clipped_torque;
+          if (quantize_float32) {
+            float target = static_cast<float>(delayed_target);
+            float pos = static_cast<float>(feedback_pos[i]);
+            float vel = static_cast<float>(feedback_vel[i]);
+            float error = position_mask[i] ? target - pos : target - vel;
+            mjtNum raw_torque = position_mask[i]
+                                    ? kp[r * nu + i] * error -
+                                          kd[r * nu + i] * vel
+                                    : kd[r * nu + i] * error;
+            float torque = static_cast<float>(raw_torque);
+            torque = static_cast<float>(
+                static_cast<mjtNum>(torque) * torque_scale[r * nu + i]);
+            torque =
+                std::min(std::max(torque, static_cast<float>(ctrl_lower[i])),
+                         static_cast<float>(ctrl_upper[i]));
+            clipped_torque = static_cast<mjtNum>(torque);
+          } else {
+            mjtNum torque =
+                position_mask[i]
+                    ? kp[r * nu + i] * (delayed_target - feedback_pos[i]) -
+                          kd[r * nu + i] * feedback_vel[i]
+                    : kd[r * nu + i] * (delayed_target - feedback_vel[i]);
+            torque *= torque_scale[r * nu + i];
+            clipped_torque =
+                std::min(std::max(torque, ctrl_lower[i]), ctrl_upper[i]);
+          }
+          computed_motor_ctrl[i] = clipped_torque;
+          held_motor_ctrl[i] = clipped_torque;
+        }
+      }
+
+      for (int i = 0; i < nu; ++i) {
+        d->ctrl[i] = held_motor_ctrl[i];
+      }
+
+      mju_zero(d->qacc_warmstart, nv);
+      for (int i = 0; i < mjNWARNING; ++i) {
+        d->warning[i].number = 0;
+      }
+      mj_step(m[r], d);
+
+      if (quantize_float32) {
+        mj_getState(m[r], d, state_scratch.data(), mjSTATE_FULLPHYSICS);
+        for (size_t i = 0; i < nstate; ++i) {
+          state_scratch[i] =
+              static_cast<mjtNum>(static_cast<float>(state_scratch[i]));
+        }
+        mj_setState(m[r], d, state_scratch.data(), mjSTATE_FULLPHYSICS);
+      }
+
+      if (t + 1 < nstep) {
+        for (int i = 0; i < nu; ++i) {
+          mjtNum pos = d->sensordata[pos_sensor_adr[i]];
+          mjtNum vel = d->sensordata[vel_sensor_adr[i]];
+          if (quantize_float32) {
+            pos = static_cast<mjtNum>(static_cast<float>(pos));
+            vel = static_cast<mjtNum>(static_cast<float>(vel));
+          }
+          feedback_pos[i] = pos;
+          feedback_vel[i] = vel;
+        }
+      }
+    }
+
+    mj_getState(m[r], d, state_out + r * nstate, mjSTATE_FULLPHYSICS);
+    mju_copy(sensordata_out + r * nsensordata, d->sensordata, nsensordata);
+    mju_copy(motor_ctrl_out + r * nu, held_motor_ctrl.data(), nu);
+    mju_copy(computed_motor_ctrl_out + r * nu,
+             computed_motor_ctrl.data(), nu);
+    mju_copy(command_delay_buffer_out + command_delay_offset,
+             command_delay_buffer.data(),
+             static_cast<size_t>(command_delay_depth) * nu);
+  }
+}
