+
+  py::tuple step_joint_position_pd(
+      int nstep, const PyCArray state0, const PyCArray actions,
+      const PyCArray kp, const PyCArray kd, const PyCArray torque_scale,
+      const PyCArray torque_limits, const PyCArray gear,
+      const PyCArray nominal, const PyCArray initial_velocity,
+      const PyIArray qpos_adr, const PyIArray qvel_adr,
+      const PyIArray delay_steps, const PyCArray initial_fifo,
+      bool position_difference, std::optional<PyCArray> wrench) {
+    if (nstep < 1) throw py::value_error("nstep must be positive");
+    int nu = models_[0]->nu;
+    if (nu < 1) throw py::value_error("joint PD requires actuators");
+    auto fifo_info = initial_fifo.request();
+    if (fifo_info.ndim != 3 || fifo_info.shape[0] != nbatch_ ||
+        fifo_info.shape[1] < 1 || fifo_info.shape[2] != nu) {
+      throw py::value_error("initial_fifo must have shape (nbatch, depth, nu)");
+    }
+    auto pos_info = qpos_adr.request(), vel_info = qvel_adr.request();
+    auto delay_info = delay_steps.request();
+    if (pos_info.size != nu || vel_info.size != nu || delay_info.size != nbatch_) {
+      throw py::value_error("invalid joint-address or delay array size");
+    }
+    JointPdArgs p{};
+    p.nu = nu; p.nstep = nstep; p.nstate = nstate_; p.nsensor = nsensordata_;
+    p.depth = static_cast<int>(fifo_info.shape[1]);
+    p.position_difference = position_difference;
+    size_t batch = static_cast<size_t>(nbatch_) * nu;
+    p.state = required_array_ptr(state0, "state0", static_cast<size_t>(nbatch_) * nstate_);
+    p.actions = required_array_ptr(actions, "actions", batch);
+    p.kp = required_array_ptr(kp, "kp", batch);
+    p.kd = required_array_ptr(kd, "kd", batch);
+    p.scale = required_array_ptr(torque_scale, "torque_scale", batch);
+    p.limits = required_array_ptr(torque_limits, "torque_limits", nu);
+    p.gear = required_array_ptr(gear, "gear", nu);
+    p.nominal = required_array_ptr(nominal, "nominal", batch);
+    p.velocity = required_array_ptr(initial_velocity, "initial_velocity", batch);
+    p.fifo = required_array_ptr(initial_fifo, "initial_fifo", batch * p.depth);
+    p.wrench = optional_array_ptr(wrench, "wrench",
+        static_cast<size_t>(nbatch_) * nstep * models_[0]->nbody * 6);
+    p.qpos_adr = static_cast<const int*>(pos_info.ptr);
+    p.qvel_adr = static_cast<const int*>(vel_info.ptr);
+    p.delay = static_cast<const int*>(delay_info.ptr);
+    for (int i = 0; i < nu; ++i) {
+      if (p.qpos_adr[i] < 0 || p.qpos_adr[i] >= models_[0]->nq ||
+          p.qvel_adr[i] < 0 || p.qvel_adr[i] >= models_[0]->nv ||
+          !std::isfinite(p.gear[i]) || p.gear[i] == 0 ||
+          !std::isfinite(p.limits[i]) || p.limits[i] < 0) {
+        throw py::value_error("invalid joint address, gear, or torque limit");
+      }
+    }
+    for (int i = 0; i < nbatch_; ++i) {
+      if (p.delay[i] < 0 || p.delay[i] >= p.depth)
+        throw py::value_error("delay_steps must index the FIFO depth");
+    }
+    PyCArray state_out({nbatch_, nstate_}), sensor_out({nbatch_, nsensordata_});
+    PyCArray torque_out({nbatch_, nu}), velocity_out({nbatch_, nu});
+    PyCArray fifo_out({nbatch_, p.depth, nu});
+    p.state_out = state_out.mutable_data(); p.sensor_out = sensor_out.mutable_data();
+    p.torque_out = torque_out.mutable_data(); p.velocity_out = velocity_out.mutable_data();
+    p.fifo_out = fifo_out.mutable_data();
+    std::vector<const raw::MjModel*> models(models_.begin(), models_.end());
+    {
+      py::gil_scoped_release no_gil;
+      if (nthread_ > 0 && nbatch_ > 1) {
+        int chunk = std::max(1, nbatch_ / (10 * nthread_));
+        InterceptMjErrors(StepJointPdThreaded)(
+            models, worker_data_, nbatch_, chunk, pool_.get(), p);
+      } else {
+        InterceptMjErrors(StepJointPdRange)(models, worker_data_[0], 0, nbatch_, p);
+      }
+    }
+    return py::make_tuple(state_out, sensor_out, torque_out, velocity_out, fifo_out);
+  }
