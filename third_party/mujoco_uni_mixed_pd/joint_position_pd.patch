+// Joint-coordinate position PD, with an offset FIFO and optional finite-difference
+// velocity. All layouts arrive from the caller's cold-path metadata cache.
+struct JointPdArgs {
+  int nu, nstep, nstate, nsensor, depth;
+  bool position_difference;
+  const mjtNum *state, *actions, *kp, *kd, *scale, *limits, *gear, *nominal;
+  const mjtNum *velocity, *fifo, *wrench;
+  const int *qpos_adr, *qvel_adr, *delay;
+  mjtNum *state_out, *sensor_out, *torque_out, *velocity_out, *fifo_out;
+};
+
+void StepJointPdRange(const std::vector<const raw::MjModel*>& models,
+                     raw::MjData* d, int begin, int end, const JointPdArgs& p) {
+  std::vector<mjtNum> previous(p.nu), velocity(p.nu), fifo(p.depth * p.nu);
+  for (int r = begin; r < end; ++r) {
+    const raw::MjModel* m = models[r];
+    const size_t offset = static_cast<size_t>(r) * p.nu;
+    const size_t fifo_offset = offset * p.depth;
+    for (int i = 0; i < m->nbody; ++i) {
+      int id = m->body_mocapid[i];
+      if (id >= 0) {
+        mju_copy3(d->mocap_pos + 3 * id, m->body_pos + 3 * i);
+        mju_copy4(d->mocap_quat + 4 * id, m->body_quat + 4 * i);
+      }
+    }
+    for (int i = 0; i < m->neq; ++i) d->eq_active[i] = m->eq_active0[i];
+    mj_setState(m, d, p.state + static_cast<size_t>(r) * p.nstate,
+                mjSTATE_FULLPHYSICS);
+    mju_zero(d->qfrc_applied, m->nv);
+    mju_zero(d->xfrc_applied, 6 * m->nbody);
+    mju_copy(velocity.data(), p.velocity + offset, p.nu);
+    mju_copy(fifo.data(), p.fifo + fifo_offset, p.depth * p.nu);
+    for (int step = 0; step < p.nstep; ++step) {
+      for (int age = p.depth - 1; age > 0; --age) {
+        mju_copy(fifo.data() + age * p.nu,
+                 fifo.data() + (age - 1) * p.nu, p.nu);
+      }
+      mju_copy(fifo.data(), p.actions + offset, p.nu);
+      for (int i = 0; i < p.nu; ++i) {
+        previous[i] = d->qpos[p.qpos_adr[i]];
+        mjtNum target = p.nominal[offset + i] + fifo[p.delay[r] * p.nu + i];
+        mjtNum torque = p.kp[offset + i] * (target - previous[i]) -
+                        p.kd[offset + i] * velocity[i];
+        torque *= p.scale[offset + i];
+        torque = std::min(std::max(torque, -p.limits[i]), p.limits[i]);
+        p.torque_out[offset + i] = torque;
+        d->ctrl[i] = torque / p.gear[i];
+      }
+      if (p.wrench) {
+        size_t address = (static_cast<size_t>(r) * p.nstep + step) * m->nbody * 6;
+        mju_copy(d->xfrc_applied, p.wrench + address, m->nbody * 6);
+      }
+      mju_zero(d->qacc_warmstart, m->nv);
+      for (int i = 0; i < mjNWARNING; ++i) d->warning[i].number = 0;
+      mj_step(m, d);
+      for (int i = 0; i < p.nu; ++i) {
+        if (p.position_difference) {
+          mjtNum delta = std::fmod(d->qpos[p.qpos_adr[i]] - previous[i] + mjPI, 2 * mjPI);
+          if (delta < 0) delta += 2 * mjPI;
+          velocity[i] = (delta - mjPI) / m->opt.timestep;
+        } else {
+          velocity[i] = d->qvel[p.qvel_adr[i]];
+        }
+      }
+    }
+    mj_getState(m, d, p.state_out + static_cast<size_t>(r) * p.nstate,
+                mjSTATE_FULLPHYSICS);
+    mju_copy(p.velocity_out + offset, velocity.data(), p.nu);
+    mju_copy(p.fifo_out + fifo_offset, fifo.data(), p.depth * p.nu);
+    // Match BatchEnvPool.step(post_step_forward_sensor=true): sensors describe
+    // the final state with applied forces/control and warmstart cleared.
+    mju_zero(d->ctrl, p.nu);
+    mju_zero(d->qfrc_applied, m->nv);
+    mju_zero(d->xfrc_applied, m->nbody * 6);
+    mju_zero(d->qacc_warmstart, m->nv);
+    for (int i = 0; i < mjNWARNING; ++i) d->warning[i].number = 0;
+    mj_forwardSkip(m, d, mjSTAGE_NONE, 0);
+    mju_copy(p.sensor_out + static_cast<size_t>(r) * p.nsensor,
+             d->sensordata, p.nsensor);
+  }
+}
+
+void StepJointPdThreaded(const std::vector<const raw::MjModel*>& models,
+                        std::vector<raw::MjData*>& data, int nbatch, int chunk,
+                        ThreadPool* pool, const JointPdArgs& p) {
+  int jobs = (nbatch + chunk - 1) / chunk;
+  pool->ResetCount();
+  for (int begin = 0; begin < nbatch; begin += chunk) {
+    int end = std::min(begin + chunk, nbatch);
+    auto task = [&, begin, end]() {
+      StepJointPdRange(models, data[pool->WorkerId()], begin, end, p);
+    };
+    pool->Schedule(task);
+  }
+  pool->WaitCount(jobs);
+}
